# Variáveis obrigatórias para produção
# Substitua os valores pelas credenciais reais do provedor (Supabase, Vercel, etc.)

# Banco de dados Postgres (connection string completa)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth
NEXTAUTH_SECRET="troque-por-um-valorsecreto-gerado"
NEXTAUTH_URL="https://seu-site.exemplo"

# Armazenamento de arquivos - adapter configurável
# Valores possíveis: "local" (padrão) ou "supabase"
STORAGE_ADAPTER="supabase"

# Supabase Storage (se usar STORAGE_ADAPTER=supabase)
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_SERVICE_KEY="service_role_key_aqui"
SUPABASE_BUCKET="repository"
