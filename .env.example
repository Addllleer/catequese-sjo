# Banco de dados PostgreSQL
# Exemplo local (ver docker-compose.yml incluso no projeto):
DATABASE_URL="postgresql://catequese:catequese@localhost:5432/catequese_sjo?schema=public"

# NextAuth
# Gere um valor aleatório com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-e-secreto"
NEXTAUTH_URL="http://localhost:3000"

# Diretório de armazenamento de arquivos do Repositório (fora de /public).
# Caminho relativo à raiz do projeto.
STORAGE_DIR="storage/repository"
